generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

enum Recipe_Status {
    LOW
    MEDIUM
    HARD
}

model Recipe {
    id          Int                 @id @default(autoincrement())
    name        String
    description String?
    status      Recipe_Status       @default(MEDIUM)
    ingredients Ingredient_Recipe[]
    chefId      Int
    chef        Chef                @relation(fields: [chefId], references: [id])
}

model Ingredient {
    id                Int                 @id @default(autoincrement())
    name              String
    quantity          Int
    contains_allergen Boolean             @default(false)
    ingredients       Ingredient_Recipe[]
}

model Ingredient_Recipe {
    recipeId Int
    recipe   Recipe @relation(fields: [recipeId], references: [id])

    ingredientId Int
    ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

    @@unique([recipeId, ingredientId])
}

model Chef {
    id      Int      @id @default(autoincrement())
    name    String
    recipes Recipe[]
}
