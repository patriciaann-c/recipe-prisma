generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

enum Recipe_Status {
    LOW
    MEDIUM
    HARD
}

model Recipe {
    id          Int           @id @default(autoincrement())
    name        String
    description String?
    status      Recipe_Status @default(MEDIUM)
}

model Ingredient {
    id                Int     @id @default(autoincrement())
    name              String
    quantity          Int
    contains_allergen Boolean @default(false)
}

model Chef {
    id   Int    @id @default(autoincrement())
    name String
}
